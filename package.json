{
  "name": "sudutku",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:check": "vitest run src/data/content.test.ts",
    "content:gen-tests": "py -I tools/gen_tests.py content/instruments",
    "icons": "node tools/gen-icons.mjs",
    "content:review": "py -I tools/gen_review.py",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.1.0",
    "dexie": "4.0.10",
    "fflate": "0.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "three": "0.170.0",
    "zod": "3.23.8",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@playwright/test": "1.49.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/node": "22.9.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "fake-indexeddb": "6.0.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.0",
    "vitest": "2.1.5"
  }
}
